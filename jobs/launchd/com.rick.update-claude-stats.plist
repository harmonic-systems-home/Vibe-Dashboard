<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rick.update-claude-stats</string>
    <key>ProgramArguments</key>
    <array>
        <string>@JOB_DIR@/update_claude_stats.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/update-claude-stats.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/update-claude-stats.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
